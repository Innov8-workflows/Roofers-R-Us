# Whitelist: the built page, its source and the deploy workflow. Raw client
# photographs and logos stay local (the K: folder is the only copy).
*
!.gitignore
!.github/
!.github/**
!index.html
!build.js
!site.config.js
!_src/
!_src/**
# build-out (2026-09-15): the generator, its content and the report. _site/,
# _staging/ and _source/ stay out - the first two are regenerable, the third
# is the client's raw upload.
!generate.js
!build-pages.js
!pages-review.js
!preview.js
!analytics-src.js
!lead-src.js
!content/
!content/**
!BUILD-REPORT.md
# The Pages preview deploys the STAGING build, so it has to be in the repo.
# Regenerate with: STAGING_BASE=Roofers-R-Us node generate.js
!_staging/
!_staging/**
